{
  "name": "math-exp-codex",
  "version": "0.1.0",
  "private": true,
  "description": "K12 交互式可视化数学实验平台",
  "type": "module",
  "scripts": {
    "build": "npm run build:site",
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "dev:app": "vite --config vite.config.ts",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "catalog:extract": "node extract_exps.js",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "pages:generate": "python3 gen_pages.py",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:deployment": "node scripts/audit-deployment.mjs",
    "check": "npm run catalog:generate && npm run pages:generate && npm run audit:assets && npm run audit:content && npm run audit:deployment && tsc --noEmit",
    "build:app": "npm run catalog:generate && vite build --config vite.config.ts",
    "build:site": "npm run build:app && node scripts/generate-experiment-pages.mjs && node scripts/assemble-site.mjs",
    "test": "npm run check && npm run test:unit && npm run build:site && npm run test:smoke",
    "test:unit": "vitest run",
    "test:smoke": "playwright test",
    "test:smoke:update": "UPDATE_SMOKE_SNAPSHOTS=1 playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "chart.js": "4.4.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
